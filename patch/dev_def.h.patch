--- a/device/include/dev_def.h
+++ b/device/include/dev_def.h
@@
 #else
 #define DEV_IIC_ENABLE		0
 #endif	/* DEVCNF_USE_IIC */
+
+#if DEVCNF_USE_BLENUS && DEV_BLENUS_UNITNM	/* Use BLE NUS device */
+#define DEV_BLENUS_ENABLE	1
+#else
+#define DEV_BLENUS_ENABLE	0
+#endif	/* DEVCNF_USE_BLENUS */
 
 #else				/* Do not use sample device driver */
 
 #define DEV_SER_ENABLE		0		// Serial communication device 
 #define DEV_ADC_ENABLE		0		// A/D conversion device
 #define DEV_IIC_ENABLE		0		// I2C communication device
+#define DEV_BLENUS_ENABLE	0		// BLE NUS device
 
 #endif	/* USE_SDEV_DRV */
 #endif	/* __DEVINC_DEVICE_H__ */
