Description: blenus_overlay.mk の -include、EXTOBJS（SoftDevice/blenus 関連
 オブジェクト）のリンク、.hex 生成をビルドに追加する。
Author: koh aiaida <koh@aiaida.jp>
Origin: PMC 362_mbit_mtk3 (micro:bit v2 用 μT-Kernel 3.0、パーソナルメディア株式会社配布)
License-of-patch: この差分（追加・変更行）自体は koh aiaida が Apache-2.0 で提供する。
 適用対象のオリジナルファイルは PMC の配布条件（T-License 2.x）に従う。本パッチは
 PMC のソースを同梱するものではなく、利用者自身が入手した PMC 配布物に適用することを
 前提とする。
--- a/build_make/makefile
+++ b/build_make/makefile
@@ -43,6 +43,8 @@ endif
 ifeq ($(TARGET), _RZA2M_)
 include iote_rza2m.mk
 endif
 ifeq ($(TARGET), _MICROBIT_)
 include microbit.mk
 endif
+
+-include blenus_overlay.mk
 
 APP = app_sample
@@ -62,17 +64,24 @@ endif
 endif
 
 # All EXE_FILE
-all: $(EXE_FILE).elf
+all: $(EXE_FILE).elf $(EXE_FILE).hex
+
+$(EXE_FILE).hex: $(EXE_FILE).elf
+	@echo 'Converting to hex: $@'
+	$(OBJCOPY) -O ihex "$(EXE_FILE).elf" "$(EXE_FILE).hex"
+	@echo 'Finished Converting: $@'
+	@echo ' '
 
 $(EXE_FILE).elf: $(OBJS)
 	@echo 'Linker: $@'
-	$(LINK)  $(LFLAGS) -T $(LNKFILE) -Wl,-Map,"$(EXE_FILE).map" -o "$(EXE_FILE).elf" $(OBJS)
+	$(LINK)  $(LFLAGS) -T $(LNKFILE) -Wl,-Map,"$(EXE_FILE).map" -o "$(EXE_FILE).elf" $(OBJS) $(EXTOBJS)
 	@echo 'Finished building target: $@'
 	@echo ' '
 
 # Other EXE_FILEs
 clean:
-	-$(RM) $(OBJS) $(SECONDARY_SIZE) $(ASM_DEPS) $(S_UPPER_DEPS) $(C_DEPS) $(EXE_FILE).elf $(EXE_FILE).map
+	-$(RM) $(OBJS) $(SECONDARY_SIZE) $(ASM_DEPS) $(S_UPPER_DEPS) $(C_DEPS) $(EXE_FILE).elf $(EXE_FILE).hex $(EXE_FILE).map
 	-@echo ' '
 
 .PHONY: all clean dependents
